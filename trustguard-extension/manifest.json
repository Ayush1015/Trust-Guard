{
  "manifest_version": 3,
  "name": "TrustGuard - Page Check",
  "short_name": "TrustGuard",
  "version": "1.1.0",
  "description": "Request news source checks, review writing-origin estimates and URL risk checks for the page you choose.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open TrustGuard page check"
    }
  }
}
